{
  "name": "strandivo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Free, open-source plasmid editor: maps, primers, cloning and sequence verification",
  "homepage": "https://strandivo.com",
  "repository": { "type": "git", "url": "https://github.com/Mateusz-Jaskolowski/Strandivo.git" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts .github/scripts/*.test.mjs services/updates/*.test.mjs",
    "check:quick": "bash .github/scripts/check-agents-paths.sh && bash .github/scripts/check-headers.sh && node .github/scripts/check-security-txt.mjs",
    "check": "npm run check:quick && node --check e2e/run.mjs && npm run typecheck && npm test && npm run build && cargo test --release --manifest-path crates/seqcore/Cargo.toml && cargo test --release --manifest-path crates/seqcore-json/Cargo.toml && cargo clippy --all-targets --manifest-path crates/seqcore-json/Cargo.toml && cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --config src-tauri/tauri.unsigned.conf.json",
    "version": "node tools/set-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@teselagen/bio-parsers": "^0.4.0",
    "@teselagen/sequence-utils": "^0.3.0",
    "buffer": "^6.0.3",
    "string_decoder": "^1.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}

# Cloudflare Pages response headers. The site is plain files, so its Content Security
# Policy allows only its own images, stylesheet and one script (download.js, which puts the
# visitor's own system's download first): nothing inline and nothing from elsewhere.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# RFC 9116 asks for this media type and charset.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Cloudflare Pages response headers. The site is plain files with no scripts, so its
# Content Security Policy allows only its own images and stylesheet.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

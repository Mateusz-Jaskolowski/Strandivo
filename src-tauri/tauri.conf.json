{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strandivo",
  "version": "0.1.0",
  "identifier": "com.strandivo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://rest.uniprot.org",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://rest.uniprot.org ws://localhost:1420",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Free, open-source plasmid editor: maps, primers, cloning and sequence verification",
    "longDescription": "A free, open-source plasmid editor for Mac, Windows and Linux: plasmid maps and sequence editing, primers, digests and cloning simulation, and sequence verification with Sanger and whole-plasmid reads.",
    "copyright": "© 2026 Mateusz Jaskolowski and Strandivo contributors. Licensed under GPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "dna"
        ],
        "name": "SnapGene DNA File",
        "description": "SnapGene sequence",
        "role": "Editor"
      },
      {
        "ext": [
          "gb",
          "gbk",
          "genbank",
          "gbff",
          "ape"
        ],
        "name": "GenBank File",
        "description": "GenBank sequence",
        "role": "Editor"
      },
      {
        "ext": [
          "fa",
          "fasta",
          "fas",
          "fna"
        ],
        "name": "FASTA File",
        "description": "FASTA sequence",
        "role": "Editor"
      },
      {
        "ext": [
          "ab1",
          "abi"
        ],
        "name": "Sequencing Trace",
        "description": "ABI sequencing trace",
        "role": "Viewer"
      },
      {
        "ext": [
          "svcheck"
        ],
        "name": "Strandivo Read Check",
        "description": "Sequencing reads checked against a sequence",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMTgwNTU2MTRFMjRDREQKUldUZFRPSVVWZ1VZM3RkMzBjbHJIbStPeVRSd0xmY1pZK2t5aUg1MzR0UjExeE1EUlRtZlRKeEYK",
      "endpoints": [
        "https://updates.strandivo.com/latest.json?target={{target}}&arch={{arch}}&version={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strandivo",
  "version": "0.1.0",
  "identifier": "com.strandivo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Plasmid maps, sequence editing and Sanger read verification",
    "longDescription": "A free, open-source desktop app for viewing and editing plasmid and DNA sequences (SnapGene .dna, GenBank, FASTA) and for checking Sanger sequencing reads against a construct.",
    "copyright": "© 2026 Mateusz Jaskolowski and Strandivo contributors. Licensed under GPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "dna"
        ],
        "name": "SnapGene DNA File",
        "description": "SnapGene sequence",
        "role": "Editor"
      },
      {
        "ext": [
          "gb",
          "gbk",
          "genbank",
          "gbff",
          "ape"
        ],
        "name": "GenBank File",
        "description": "GenBank sequence",
        "role": "Editor"
      },
      {
        "ext": [
          "fa",
          "fasta",
          "fas",
          "fna"
        ],
        "name": "FASTA File",
        "description": "FASTA sequence",
        "role": "Editor"
      },
      {
        "ext": [
          "ab1",
          "abi"
        ],
        "name": "Sequencing Trace",
        "description": "ABI sequencing trace",
        "role": "Viewer"
      },
      {
        "ext": [
          "svcheck"
        ],
        "name": "Strandivo Read Check",
        "description": "Sequencing reads checked against a sequence",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
